{
  "name": "lambda",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs",
    "package": "npm run build && cd dist && zip -r ../function.zip index.cjs",
    "dev": "tsx watch src/local.ts",
    "dev:emulator": "tsx watch src/lambda-emulator.ts",
    "invoke": "tsx src/invoke.ts"
  },
  "dependencies": {
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
